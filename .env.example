# ==========================================
# REAMusicApp - Environment Configuration
# ==========================================
# (Optional) Google Cloud Console OAuth 2.0 Credentials
# Required only if you want to enable Google Sign-In and profile sync (Avatar & Name)
# Create an OAuth 2.0 Client ID (Application Type: Desktop app)
# at: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# (Optional) Local loopback OAuth redirect server port (Default: 8088)
OAUTH_REDIRECT_PORT=8088

# (Optional) Custom path to mpv binary (if not already added to system PATH)
# MPV_PATH=C:\path\to\mpv.exe
