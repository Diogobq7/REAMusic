# ==========================================
# REAMusicApp - Git Ignore Rules
# ==========================================

# Virtual environments and Python packages
.venv/
venv/
env/
ENV/
*.egg-info/
.installed.cfg
*.egg

# Bytecode and Python runtime caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Environment files and credentials
.env
.env.local
.env.*.local
*.env

# Local SQLite databases and persistent data
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# User session, auth tokens, and local profiles
session.json
credentials.json
client_secrets*.json
token.json
tokens.json

# Compilation and packaging build artifacts
dist/
build/
*.spec
out/

# Binaries, executables, and dynamic libraries
*.exe
*.dll
*.so
*.dylib
*.pyd

# Operating system and logging files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
Desktop.ini

# IDE and editor workspaces
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
